{
  "manifest_version": 3,
  "name": "Insta AI Comment Assistant",
  "version": "1.0",
  "description": "Generate AI comments on Instagram posts and reels",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
