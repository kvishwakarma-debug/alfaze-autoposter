{
  "manifest_version": 3,
  "name": "Instagram AI Comment Assistant",
  "version": "1.0",
  "description": "Generate AI comments on Instagram posts and reels",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
